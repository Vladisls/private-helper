<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with every Windows 10/11, so the exe runs without installing anything -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CabalHelper</AssemblyName>
    <RootNamespace>CAHelper</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Cabal Helper</Product>
    <Version>3.0.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Windows' built-in text reader (Windows.Media.Ocr) for Party Check -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <!-- Tesseract (Apache-2.0) in digits-only mode for the Farm Tracker's stack counts. Its managed Tesseract.dll and
         the native x64/x86 DLLs are not part of the exe: they ship in the OCR package (ocr/ next to the exe). -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- ZipFile, for unpacking the OCR package in the updater -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
